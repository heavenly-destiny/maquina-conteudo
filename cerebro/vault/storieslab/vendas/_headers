/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN

# Browser cache (speed for returning visitors). Fonts are cached forever, so a changed font MUST get a
# new file name (e.g. -v2); images keep their names when replaced, so they get a week instead of forever.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/media/*
  Cache-Control: public, max-age=604800
